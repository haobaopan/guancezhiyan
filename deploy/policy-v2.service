[Unit]
Description=Policy research workspace V2
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=policy
Group=policy
WorkingDirectory=/opt/policy
EnvironmentFile=/etc/policy/v2.env
ExecStart=/usr/bin/python3 /opt/policy/应用平台_v2.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/policy/data
[Install]
WantedBy=multi-user.target
